{
  "name": "map.bdp-rps.de",
  "description": "Map app",
  "private": true,
  "scripts": {
    "lint": "pnpm exec eslint . --quiet",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next export",
    "build:deps": "cd ../.. && pnpm exec turbo run build --filter=map.bdp-rps.de^...",
    "vercel:build": "pnpm build:deps && cd ../.. && pnpm exec turbo run build --filter=map.bdp-rps.de --force --no-cache",
    "vercel:install": "pnpm i -r"
  },
  "dependencies": {
    "@bdp-rps/ui": "workspace:*",
    "leaflet": "^1.7.1",
    "leaflet-control-geocoder": "^2.4.0",
    "next": "^12.0.7",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-leaflet": "^3.2.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "9.3.4",
    "@babel/node": "^7.8.7",
    "eslint-config-next": "12.3.1"
  }
}
