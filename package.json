{
  "private": true,
  "name": "bdp-rps",
  "repository": "https://github.com/bdp-rps/monorepo.git",
  "license": "MIT",
  "scripts": {
    "postinstall": "yarn turbo run setup",
    "build": "yarn turbo run build",
    "format": "prettier --write \"**/*.js\"",
    "test": "yarn turbo run test",
    "check": "yarn format && yarn test && yarn lint",
    "lint": "eslint packages apps --quiet",
    "dev": "yarn turbo run dev --parallel --no-cache"
  },
  "devDependencies": {
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "turbo": "^1.0.6"
  },
  "workspaces": [
    "packages/*"
  ],
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          ".next/**",
          "lib/**",
          "es/**",
          "out/**"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ],
        "outputs": []
      },
      "setup": {
        "outputs": [
          "lib/**",
          "es/**",
          "out/**"
        ]
      },
      "dev": {
        "cache": false
      }
    }
  }
}
