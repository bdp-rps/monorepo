{
  "$schema": "https://turborepo.org/schema.json",
  "baseBranch": "origin/master",
  "pipeline": {
    "format": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"]
    },
    "@bdp-rps/ui#build": {
      "outputs": ["lib/**", "es/**"]
    },
    "playroom.bdp-rps.app#build": {
      "outputs": ["out/**"]
    },
    "@bdp-rps/react-pdf#build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["**/__snapshots__/**"]
    },
    "analyze": {
      "dependsOn": ["^build"],
      "outputs": [".next/analyze/**"]
    },
    "setup": {
      "outputs": ["dist/**", "lib/**", "es/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false
    }
  }
}
