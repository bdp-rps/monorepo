{
  "$schema": "https://turborepo.org/schema.json",
  "pipelines": {
    "format": {
      "cache": false
    },
    "build": {
      "outputs": [".next/**"]
    },
    "@bdp-rps/ambrose#build": {
      "outputs": ["lib/**", "es/**"]
    },
    "@bdp-rps/liedgut#build": {
      "outputs": ["lib/**", "es/**", "src/**"]
    },
    "@bdp-rps/ui#build": {
      "outputs": ["lib/**", "es/**", "src/components/icons/js"]
    },
    "@bdp-rps/shared#build": {
      "outputs": ["lib/**", "es/**"]
    },
    "@bdp-rps/react-pdf-renderer#build": {
      "outputs": ["dist/**"]
    },
    "playroom.bdp-rps.de#build": {
      "outputs": ["out/**"]
    },
    "liedgut.bdp-rps.de": {
      "dependsOn": ["@bdp-rps/liedgut#build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["**/__snapshots__/**"]
    },
    "analyze": {
      "dependsOn": ["^build"],
      "outputs": [".next/analyze/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false
    }
  }
}
