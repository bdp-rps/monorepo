{
  "name": "@bdp-rps/liedgut",
  "description": "Vorlagen, Inhalte und Zusatzmaterial rund ums Thema Liedgut",
  "version": "0.0.9",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**",
    "dist/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf dist lib es coverage && mkdir dist",
    "build": "yarn run clean && yarn build:songlist && yarn build:ohrwurm && yarn build:package",
    "build:package": "yarn build:es && yarn build:lib",
    "build:es": "babel src --out-dir es --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --copy-files",
    "build:song": "babel-node scripts/page",
    "build:ohrwurm": "babel-node scripts/full",
    "build:songlist": "babel-node scripts/songList"
  },
  "dependencies": {
    "@babel/node": "^7.7.4",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-transform-runtime": "^7.7.6",
    "@babel/preset-env": "^7.7.6",
    "@babel/preset-react": "^7.7.4",
    "@bdp-rps/react-pdf-renderer": "^0.0.9",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "rimraf": "^3.0.0"
  },
  "devDependencies": {
    "@babel/polyfill": "^7.2.5"
  },
  "gitHead": "5ee69ff9b55ad4660785422eab899744c8b346fb"
}
