{
  "name": "@bdp-rps/liedgut",
  "description": "Vorlagen, Inhalte und Zusatzmaterial rund ums Thema Liedgut",
  "version": "0.0.24",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**",
    "dist/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "dev": "next dev",
    "clean": "rimraf public/dist lib es coverage && mkdir public/dist",
    "songlist": "babel-node scripts/songList",
    "normalize": "babel-node scripts/normalize",
    "vercel-build": "yarn build:page",
    "start": "next start",
    "export": "next export",
    "deploy": "vercel --prod",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "yarn run clean && yarn songlist && yarn normalize && yarn build:package",
    "build:page": "yarn build && yarn build:book && yarn build:songs && next build",
    "build:package": "yarn build:es && yarn build:lib",
    "build:es": "babel src --out-dir es --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --copy-files",
    "build:song": "babel-node scripts/song",
    "build:songs": "babel-node scripts/songs",
    "build:book": "babel-node scripts/book"
  },
  "dependencies": {
    "@bdp-rps/react-pdf-renderer": "^0.0.24",
    "@bdp-rps/ui": "^0.0.24",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "next": "^9.3.1",
    "node-fetch": "^2.6.0",
    "onegraph-auth": "^2.2.1",
    "react": "^16.12.0",
    "react-abc": "^0.4.0",
    "react-dom": "^16.12.0",
    "rimraf": "^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.11.6",
    "@babel/core": "^7.11.6",
    "@babel/node": "^7.7.4",
    "@babel/plugin-proposal-class-properties": "^7.7.4",
    "@babel/plugin-transform-runtime": "^7.7.6",
    "@babel/polyfill": "^7.2.5",
    "@babel/preset-env": "^7.7.6",
    "@babel/preset-react": "^7.7.4",
    "cross-env": "^6.0.3"
  },
  "gitHead": "09e19151ab54a017720eeeeed33131db1a5651e2"
}
