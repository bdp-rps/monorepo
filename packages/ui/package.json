{
  "name": "@bdp-rps/ui",
  "version": "1.0.0",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "setup": "pnpm build",
    "lint": "pnpm exec eslint . --quiet",
    "clean": "rimraf lib es coverage",
    "build": "pnpm clean && pnpm build:icons && pnpm build:package",
    "build:styleguide": "styleguidist build",
    "build:package": "pnpm build:es && pnpm build:lib",
    "build:icons": "rimraf src/components/icons/js && svgr -d src/components/icons/js src/components/icons/svg --config-file ./svgr.config.js && babel-node scripts/buildIcons.js",
    "build:es": "babel src --out-dir es --ignore \"src/__tests__\" --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --ignore \"src/__tests__\" --copy-files",
    "dev": "npm run dev:lib & npm run dev:es",
    "dev:lib": "BABEL_ENV=commonjs babel src -d lib -w",
    "dev:es": "babel src -d es -w",
    "test": "cross-env BABEL_ENV=commonjs echo 1",
    "coverage": "pnpm test --coverage",
    "styleguide": "styleguidist server"
  },
  "repository": "https://github.com/bdp-rps/monorepo.git",
  "author": "BdP LV RPS <medien@bdp-rps.de>",
  "license": "MIT",
  "dependencies": {
    "@bdp-rps/ambrose": "workspace:*",
    "fast-loops": "^1.1.3",
    "fela": "^12.2.1",
    "fela-enforce-longhands": "^12.2.1",
    "fela-monolithic": "^11.7.0",
    "fela-plugin-custom-property": "^12.2.1",
    "fela-plugin-hover-media": "^12.2.1",
    "fela-plugin-multiple-selectors": "^12.2.1",
    "fela-plugin-named-keys": "^12.2.1",
    "fela-plugin-responsive-value": "^12.2.1",
    "fela-plugin-theme-value": "^12.2.1",
    "fela-preset-web": "^12.2.1",
    "fela-sort-media-query-mobile-first": "^12.2.1",
    "kilvin": "^3.1.1",
    "next": "^12.0.7",
    "prop-types": "^15.7.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-fela": "^12.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.13.16",
    "@babel/core": "^7.2.2",
    "@babel/node": "^7.13.13",
    "@babel/plugin-transform-modules-commonjs": "^7.5.0",
    "@babel/polyfill": "^7.7.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@svgr/cli": "^5.5.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^23.6.0",
    "babel-loader": "^8.1.0",
    "cross-env": "^6.0.3",
    "jest": "^23.6.0",
    "react-styleguidist": "^11.1.0",
    "rimraf": "^3.0.0",
    "webpack": "^4.44.2"
  }
}
