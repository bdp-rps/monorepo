{
  "name": "@bdp-rps/ui",
  "version": "0.0.11",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "clean": "rimraf lib es coverage",
    "build": "yarn clean && yarn build:package && yarn build:tools",
    "build:package": "yarn build:es && yarn build:lib",
    "build:es": "babel src --out-dir es --ignore \"src/__tests__\" --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --ignore \"src/__tests__\" --copy-files",
    "build:styleguide": "styleguidist build",
    "build:playroom": "playroom build",
    "build:tools": "yarn build:styleguide && yarn build:playroom",
    "test": "cross-env BABEL_ENV=commonjs echo 1",
    "coverage": "yarn test --coverage",
    "styleguide": "styleguidist server",
    "release": "yarn build && npm publish"
  },
  "repository": "https://github.com/bdp-rps/mono.git",
  "author": "BdP LV RPS <medien@bdp-rps.de>",
  "license": "MIT",
  "dependencies": {
    "fela": "^11.2.0",
    "fela-plugin-named-keys": "^11.2.0",
    "fela-plugin-responsive-value": "^11.2.0",
    "fela-plugin-rtl": "^11.2.0",
    "fela-preset-web": "^11.2.0",
    "fela-sort-media-query-mobile-first": "^11.2.0",
    "prop-types": "^15.7.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-fela": "^11.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.2.0",
    "@babel/core": "^7.2.2",
    "@babel/plugin-transform-modules-commonjs": "^7.5.0",
    "@babel/polyfill": "^7.7.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@svgr/cli": "^4.3.2",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^23.6.0",
    "babel-loader": "^8.1.0",
    "cross-env": "^6.0.3",
    "jest": "^23.6.0",
    "playroom": "^0.16.1",
    "react-styleguidist": "^11.0.4",
    "rimraf": "^3.0.0"
  },
  "gitHead": "271ce7b81b340654f5cc2c516f9f5fef4bb04db5"
}
