{
  "name": "@bdp-rps/ui",
  "version": "0.0.25",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**",
    "src/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "clean": "rimraf lib es coverage",
    "vercel-build": "yarn build:styleguide",
    "deploy": "vercel --prod",
    "prepare": "yarn build:package",
    "build": "yarn clean && yarn build:package",
    "build:styleguide": "styleguidist build",
    "build:package": "yarn build:es && yarn build:lib",
    "build:icons": "rimraf src/components/icons/js && svgr -d src/components/icons/js src/components/icons/svg --config-file ./svgr.config.js && babel-node scripts/buildIcons.js",
    "build:es": "babel src --out-dir es --ignore \"src/__tests__\" --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --ignore \"src/__tests__\" --copy-files",
    "watch": "npm run watch:lib & npm run watch:es",
    "watch:lib": "BABEL_ENV=commonjs babel src -d lib -w",
    "watch:es": "babel src -d es -w",
    "test": "cross-env BABEL_ENV=commonjs echo 1",
    "coverage": "yarn test --coverage",
    "dev": "styleguidist server"
  },
  "repository": "https://github.com/bdp-rps/monorepo.git",
  "author": "BdP LV RPS <medien@bdp-rps.de>",
  "license": "MIT",
  "dependencies": {
    "fela": "^11.2.0",
    "fela-plugin-named-keys": "^11.2.0",
    "fela-plugin-responsive-value": "^11.2.0",
    "fela-plugin-rtl": "^11.2.0",
    "fela-preset-web": "^11.2.0",
    "fela-sort-media-query-mobile-first": "^11.2.0",
    "kilvin": "^2.0.9",
    "prop-types": "^15.7.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-fela": "^11.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.13.16",
    "@babel/core": "^7.2.2",
    "@babel/node": "^7.13.13",
    "@babel/plugin-transform-modules-commonjs": "^7.5.0",
    "@babel/polyfill": "^7.7.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@svgr/cli": "^5.5.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^23.6.0",
    "babel-loader": "^8.1.0",
    "cross-env": "^6.0.3",
    "jest": "^23.6.0",
    "react-styleguidist": "^11.1.0",
    "rimraf": "^3.0.0",
    "webpack": "^4.44.2"
  },
  "gitHead": "09e19151ab54a017720eeeeed33131db1a5651e2"
}
