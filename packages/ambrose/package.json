{
  "name": "@bdp-rps/ambrose",
  "version": "1.0.0",
  "main": "lib/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/**",
    "es/**",
    "src/**"
  ],
  "browserslist": [
    "IE >= 11",
    "Firefox >= 60",
    "Safari >= 11.1",
    "Chrome >= 66",
    "ChromeAndroid >= 66",
    "iOS >= 11.3",
    "Edge >= 15"
  ],
  "scripts": {
    "clean": "rimraf lib es coverage",
    "setup": "pnpm build",
    "build": "pnpm clean && pnpm build:package",
    "build:package": "pnpm build:es && pnpm build:lib",
    "build:es": "babel src --out-dir es --ignore \"src/__tests__\" --copy-files",
    "build:lib": "cross-env BABEL_ENV=commonjs babel src --out-dir lib --ignore \"src/__tests__\" --copy-files",
    "dev": "npm run dev:lib & npm run dev:es",
    "dev:lib": "BABEL_ENV=commonjs babel src -d lib -w",
    "dev:es": "babel src -d es -w",
    "test": "jest --config=jest.config.js",
    "coverage": "pnpm test --coverage",
    "release": "pnpm build && pnpm test && npm publish"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "small-date": "^2.0.0"
  },
  "peerDependencies": {
    "kilvin": "^4.1.0",
    "fela": "^12.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-fela": "^12.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.2.0",
    "@babel/core": "^7.2.2",
    "@babel/node": "^7.13.0",
    "@babel/plugin-transform-modules-commonjs": "^7.5.0",
    "@babel/polyfill": "^7.7.0",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@svgr/cli": "^5.5.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^27.0.2",
    "cross-env": "^6.0.3",
    "fela": "^12.2.1",
    "jest": "^26.6.0",
    "jest-react-fela": "^12.2.1",
    "jsdom": "^16.6.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-fela": "^12.2.1",
    "rimraf": "^3.0.0"
  }
}
